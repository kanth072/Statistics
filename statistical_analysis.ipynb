# ===============================
# STATISTICAL ANALYSIS PROJECT
# ===============================

# -------- Day 0: Import Libraries --------
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy import stats
from sklearn.linear_model import LinearRegression

# -------- Load Dataset --------

df = pd.read_csv("/content/sales_data (1).csv")

# ========================================
# Day 1: Descriptive Statistics
# ========================================
sales = df['Total_Sales']

mean_sales = sales.mean()
median_sales = sales.median()
mode_sales = sales.mode()[0]
std_sales = sales.std()

# ========================================
# Day 2: Data Distribution Analysis
# ========================================
# Histogram
plt.figure()
plt.hist(sales, bins=10)
plt.title("Sales Distribution")
plt.xlabel("Total Sales")
plt.ylabel("Frequency")
plt.show()

# Normality Test
shapiro_stat, shapiro_p = stats.shapiro(sales.sample(min(500, len(sales))))

# ========================================
# Day 3: Correlation Analysis
# ========================================
correlation = df[['Quantity', 'Total_Sales']].corr().iloc[0, 1]

# Heatmap
plt.figure()
plt.imshow(df[['Quantity', 'Total_Sales']].corr())
plt.colorbar()
plt.xticks([0, 1], ['Quantity', 'Total_Sales'])
plt.yticks([0, 1], ['Quantity', 'Total_Sales'])
plt.title("Correlation Heatmap")
plt.show()

# ========================================
# Day 4: Hypothesis Testing
# ========================================
# ANOVA: Sales across Regions
region_groups = [group['Total_Sales'].values for _, group in df.groupby('Region')]
anova_stat, anova_p = stats.f_oneway(*region_groups)

# ========================================
# Day 5: Confidence Intervals
# ========================================
confidence_level = 0.95
ci_low, ci_high = stats.t.interval(
    confidence_level,
    len(sales) - 1,
    mean_sales,
    stats.sem(sales)
)

margin_of_error = mean_sales - ci_low

# ========================================
# Day 6: Regression Analysis
# ========================================
X = df[['Quantity']]
y = df['Total_Sales']

model = LinearRegression()
model.fit(X, y)

r_squared = model.score(X, y)

# ========================================
# Day 7: Business Insights & Report
# ========================================
report = f"""
STATISTICAL ANALYSIS REPORT

Average Sales: ₹{mean_sales:,.2f} ± ₹{margin_of_error:,.2f} (95% CI)

Correlation (Quantity vs Sales): {correlation:.2f}

Normality Test (Shapiro-Wilk):
p-value = {shapiro_p:.4f}

Hypothesis Testing (ANOVA - Sales by Region):
p-value = {anova_p:.4f}

Regression Analysis:
R-squared = {r_squared:.2f}
"""

print(report)

# -------- Save Outputs --------
with open('/content/statistical_report.txt', 'w') as f:
    f.write(report)

with open('/content/hypothesis_tests_results.txt', 'w') as f:
    f.write(f"ANOVA p-value: {anova_p:.4f}")
